# Copy to infra/.env and fill every value with a freshly generated secret (infra/.env is git-ignored).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"      -> passwords and FV_SECRET_KEY (use 48 bytes for the key)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   -> FV_ENCRYPTION_KEY
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
FV_SECRET_KEY=
FV_ENCRYPTION_KEY=
FV_APP_ENV=dev

# Vision AI (optional, needs a GPU host, see docs/vision-service.md)
FV_VISION_TOKEN=change-me-to-32-or-more-random-characters
FV_VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct
