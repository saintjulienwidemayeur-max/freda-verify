# Copy to .env (never commit .env). Every secret must be generated, not reused:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FV_APP_ENV=dev                       # dev | test | prod
FV_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/freda
FV_SECRET_KEY=                       # >= 32 chars, REQUIRED in prod (JWT signing)
FV_ENCRYPTION_KEY=                   # Fernet key for TOTP secrets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FV_CORS_ORIGINS=["https://freda-verify.onrender.com","https://fredaverify.com","https://www.fredaverify.com","http://localhost:3000"]
FV_REDIS_URL=                        # optional: shared rate limiting (redis://localhost:6379/0); in-memory limiter if empty
FV_TRUST_PROXY=false                 # true only behind a trusted reverse proxy (uses X-Forwarded-For)
FV_ACCESS_TOKEN_MINUTES=15
FV_REFRESH_TOKEN_DAYS=14

# Optional presentation-attack detection plug-in (DISABLED when empty; no model ships with the product, see CLAUDE.md "Liveness")
# FV_PAD_MODEL_PATH=/opt/pad/model.onnx
# FV_PAD_INPUT=80
# FV_PAD_REAL_INDEX=1
# FV_PAD_CROP_SCALE=2.7
# FV_PAD_THRESHOLD=0.5
